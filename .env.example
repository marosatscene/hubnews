PORT=4000
STORAGE_DRIVER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
AGGREGATOR_ENABLED=true
AGGREGATOR_CRON=*/5 * * * *
DEFAULT_CHECK_INTERVAL_MINUTES=60
MAX_ARTICLES_PER_SOURCE=40
REQUEST_TIMEOUT_MS=15000
SCRAPER_USER_AGENT=HubNewsBot/0.1 (+https://example.com/bot)
CRON_SECRET=
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2/scrape
FIRECRAWL_TIMEOUT_MS=60000
CHECKER_BATCH_SIZE=5
CHECKER_MAX_RUNTIME_MS=45000
FIRECRAWL_MIN_DIRECT_RESULTS=3
ARTICLE_MIN_WORD_COUNT=150
ARTICLE_EXTRACTION_LIMIT_PER_SOURCE=5
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ROBOTS_BOT_NAME=HubNewsBot
ROBOTS_WARNINGS_MAX_STORED=50

# Optional: direct OpenAI topic/headline classifier.
OPENAI_API_KEY=
OPENAI_FILTER_MODEL=gpt-4.1-mini
OPENAI_RESPONSES_API_URL=https://api.openai.com/v1/responses

# Present but currently unused by the backend.
FREEPIK_API_KEY=

# Optional: point this at your own LLM proxy endpoint.
# It should accept { topic, articles } and return { results: [...] }.
# If set, this takes priority over direct OpenAI filtering.
LLM_FILTER_URL=
